#!/bin/sh
set -eu
cd "$(dirname "$0")"

# Rebuild words.csv from vocabulary
printf '%s\n' 'word,part_of_speech,translation,example,source_date,source_file' > words.csv
for f in vocabulary/vocabulary-*.md; do
  [ -f "$f" ] || continue
  base=$(basename "$f"); date=${base#vocabulary-}; date=${date%.md}
  awk -v date="$date" -v file="$f" '
    BEGIN { FS = ": "; }
    /^- / {
      line=$0
      sub(/^- /, "", line)
      if (index(line, ": ") == 0) next
      word=line; sub(/: .*/, "", word)
      trans=line; sub(/^[^:]*: /, "", trans)
      pos="expr"
      if (word ~ /^el |^la |^los |^las /) pos="noun"
      else if (word ~ /ar$|er$|ir$/) pos="verb"
      gsub(/"/, "\"\"", word)
      gsub(/"/, "\"\"", trans)
      printf("\"%s\",\"%s\",\"%s\",\"\",\"%s\",\"%s\"\n", word, pos, trans, date, file)
    }
  ' "$f" >> words.csv
done

# Regenerate index.md
INDEX_FILE="index.md"
lessons=$(ls -1 lessons/lesson-*.md 2>/dev/null || true)
vocabs=$(ls -1 vocabulary/vocabulary-*.md 2>/dev/null || true)
latest_lesson=$(echo "$lessons" | tail -n 1 || true)
latest_vocab=$(echo "$vocabs" | tail -n 1 || true)
{
  echo "# Spanish Study Index"
  echo
  echo "Welcome! Use the links below to navigate."
  echo
  if [ -n "${latest_lesson:-}" ] || [ -n "${latest_vocab:-}" ]; then
    echo "## Quick access (latest)"
    [ -n "${latest_lesson:-}" ] && echo "- Latest lesson: [$(basename "$latest_lesson")](${latest_lesson})"
    [ -n "${latest_vocab:-}" ] && echo "- Latest vocabulary: [$(basename "$latest_vocab")](${latest_vocab})"
    echo
  fi
  echo "## Lessons"
  if [ -n "$lessons" ]; then
    echo "$lessons" | while IFS= read -r f; do
      [ -z "$f" ] && continue
      base=$(basename "$f"); date=${base#lesson-}; date=${date%.md}
      echo "- [${date}](./${f})"
    done
  else
    echo "- (none yet)"
  fi
  echo
  echo "## Vocabulary"
  if [ -n "$vocabs" ]; then
    echo "$vocabs" | while IFS= read -r f; do
      [ -z "$f" ] && continue
      base=$(basename "$f"); date=${base#vocabulary-}; date=${date%.md}
      echo "- [${date}](./${f})"
    done
  else
    echo "- (none yet)"
  fi
  echo
} > "$INDEX_FILE"

echo "Updated words.csv and index.md"
