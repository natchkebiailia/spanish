#!/bin/sh
set -eu
cd "$(dirname "$0")"

# Rebuild words.csv from vocabulary
printf '%s\n' 'word,part_of_speech,translation,example,source_date,source_file' > words.csv
for f in vocabulary/vocabulary-*.md; do
  [ -f "$f" ] || continue
  base=$(basename "$f"); date=${base#vocabulary-}; date=${date%.md}
  awk -v date="$date" -v file="$f" '
    BEGIN { FS = ": "; }
    /^- / {
      line=$0
      sub(/^- /, "", line)
      if (index(line, ": ") == 0) next
      word=line; sub(/: .*/, "", word)
      trans=line; sub(/^[^:]*: /, "", trans)
      pos="expr"
      if (word ~ /^el |^la |^los |^las /) pos="noun"
      else if (word ~ /ar$|er$|ir$/) pos="verb"
      gsub(/"/, "\"\"", word)
      gsub(/"/, "\"\"", trans)
      printf("\"%s\",\"%s\",\"%s\",\"\",\"%s\",\"%s\"\n", word, pos, trans, date, file)
    }
  ' "$f" >> words.csv
done

# Regenerate index.md
INDEX_FILE="index.md"
lessons=$(find lessons -maxdepth 1 -type f -name 'lesson-*.md' -print | sort || true)
vocabs=$(find vocabulary -maxdepth 1 -type f -name 'vocabulary-*.md' -print | sort || true)
latest_lesson=$(printf '%s\n' "$lessons" | tail -n 1 || true)
latest_vocab=$(printf '%s\n' "$vocabs" | tail -n 1 || true)
{
  echo "# Español"
  echo
  echo "¡Bienvenido! Usa los enlaces abajo para navegar."
  echo
  if [ -n "${latest_lesson:-}" ] || [ -n "${latest_vocab:-}" ]; then
    echo "## Acceso rápido (lo más reciente)"
    if [ -n "${latest_lesson:-}" ]; then
      latest_lesson_name=$(basename "$latest_lesson")
      echo "- Última lección: [${latest_lesson_name}](${latest_lesson})"
    fi
    if [ -n "${latest_vocab:-}" ]; then
      latest_vocab_name=$(basename "$latest_vocab")
      echo "- Último vocabulario: [${latest_vocab_name}](${latest_vocab})"
    fi
    echo
  fi
  echo "## Lecciones"
  if [ -n "$lessons" ]; then
    echo "$lessons" | while IFS= read -r f; do
      [ -z "$f" ] && continue
      base=$(basename "$f"); date=${base#lesson-}; date=${date%.md}
      echo "- [${date}](./${f})"
    done
  else
    echo "- (aún no hay)"
  fi
  echo
  echo "## Vocabulario"
  if [ -n "$vocabs" ]; then
    echo "$vocabs" | while IFS= read -r f; do
      [ -z "$f" ] && continue
      base=$(basename "$f"); date=${base#vocabulary-}; date=${date%.md}
      echo "- [${date}](./${f})"
    done
  else
    echo "- (aún no hay)"
  fi
  echo
} > "$INDEX_FILE"

echo "Updated words.csv and index.md"
